# Copy to site/.env  — never commit .env
# Do not put PayPal passwords here. Create a REST app at developer.paypal.com

DTRT_SITE_PORT=8787
DTRT_SITE_SECRET=change-this-admin-token

# sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

# Leave PREORDER_ENABLED=false until a sandbox purchase succeeds end-to-end.
PREORDER_ENABLED=false
# Authoritative price. The browser cannot change this.
PREORDER_PRICE_USD=

# Optional. Used only if you later add SMTP. Forms still save to site/data/*.jsonl
CONTACT_TO=
PRESS_TO=
SUPPORT_TO=
